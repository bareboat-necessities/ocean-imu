\section{Almost-Global Proxy Entry to Regional Live Stability}
\label{sec:semiglobal-stability}

Startup uses a private measurement-only Mahony observer while the MEKF remains
outside Live mode.  The observer supplies a quantitative gravity-direction
entry bound on compact subsets of its almost-global basin.  The accepted
handoff defines the compact set $\mathcal H$ that initializes the source-node
Lyapunov funnels of Theorem~\ref{thm:finite-live-capture}.  The source enters
Live with accelerometer-bias learning held, so the first normal-Live interval
uses the held-bias branch of Theorem~\ref{thm:iss-21-ues}.

\subsection{Explicit Mahony startup estimate}
\label{sec:semiglobal-proxy}

Let $\vct d\in\mathbb S^2$ be true body-frame down and
$\widehat{\vct d}_P\in\mathbb S^2$ the private observer prediction.  Define
\begin{equation}
 c_P:=\vct d^\top\widehat{\vct d}_P=\cos\theta_P,
 \qquad
 \vct e_P:=\vct d\times\widehat{\vct d}_P,
 \qquad \|\vct e_P\|=\sin\theta_P.
 \label{eq:semiglobal-tilt-error}
\end{equation}
The source stores $2k_P=0.2$ and $2k_I=0.02$, hence
\begin{equation}
 \boxed{k_P=0.1\ \mathrm{s}^{-1},\qquad
        k_I=0.01\ \mathrm{s}^{-2}.}
 \label{eq:semiglobal-proxy-gains}
\end{equation}
Let $\vct\beta$ be the observer integral term added to gyro and define the
observable residual bias in the gravity tangent plane by
\begin{equation}
 \widetilde{\vct\beta}:=\vct b_g+\vct\beta,
 \qquad
 \widetilde{\vct\beta}_\perp
 :=(\mat I-\vct d\vct d^\top)\widetilde{\vct\beta}.
 \label{eq:semiglobal-proxy-bias-error}
\end{equation}

Write the physical specific force as
\begin{equation}
 -\vct f^B=g\vct d+\vct a_f,
 \qquad \|\vct a_f\|\le\bar f_P<g.
 \label{eq:semiglobal-proxy-force-bound}
\end{equation}
Then
\begin{equation}
 \angle(\vct d_m,\vct d)
 \le\eta_f:=\sin^{-1}(\bar f_P/g),
 \qquad
 \|\vct\nu_\varepsilon\|
 \le\bar\nu_f:=2\sin(\eta_f/2),
 \label{eq:semiglobal-proxy-direction-error}
\end{equation}
where the measured direction error is
$\vct\varepsilon_P=\vct e_P+\vct\nu_\varepsilon$.
The observer is seeded from the first valid accelerometer sample and its
integral state is zero at reset, so a physical initial gyro-bias bound gives
\begin{equation}
 \theta_P(0)\le\eta_{f,0},
 \qquad
 \|\widetilde{\vct\beta}_\perp(0)\|\le B_{\beta,0}.
 \label{eq:semiglobal-proxy-source-seed}
\end{equation}

In a transported tangent frame the reduced source dynamics can be written
\begin{align}
 \mathsf D_t\widehat{\vct d}_P
 &=-\bigl(\widetilde{\vct\beta}_\perp
          +k_P\vct e_P+\vct w_\omega\bigr)
       \times\widehat{\vct d}_P,\\
 \mathsf D_t\widetilde{\vct\beta}_\perp
 &=k_I\vct e_P+\vct w_b,
 \label{eq:semiglobal-proxy-reduced-dynamics}
\end{align}
with calculable bounds
\begin{equation}
 \|\vct w_\omega\|\le\bar w_\omega,
 \qquad \|\vct w_b\|\le\bar w_b.
 \label{eq:semiglobal-proxy-disturbance-bounds}
\end{equation}
These terms include gyro noise and bias drift, the direction perturbation of
Eq.~\eqref{eq:semiglobal-proxy-direction-error}, bounded tangent-frame
transport, and bounded discrete normalization/integration defect.

The smooth gravity-only observer has the antipodal critical set
$\mathcal U_P$.  Let
\begin{equation}
 \mathcal N_P:=W^s(\mathcal U_P),
 \qquad
 \mathcal D_P=(\mathbb S^2\times\mathbb R^2)\setminus\mathcal N_P.
 \label{eq:semiglobal-proxy-domain}
\end{equation}
The disturbance-free flow is almost-global on $\mathcal D_P$
\cite{Mahony2008NonlinearComplementary}.  For a quantitative compact chart,
choose
\begin{equation}
 0<\epsilon<\frac{\pi}{2},
 \qquad
 \theta_\star=\frac{\pi}{2}-\epsilon,
 \qquad
 c_\star=\cos\theta_\star>0,
 \label{eq:semiglobal-proxy-chart}
\end{equation}
and
\begin{equation}
 \mathcal K_{\epsilon,B_\beta}
 :=\{\theta_P\le\theta_\star,
      \ \|\widetilde{\vct\beta}_\perp\|\le B_\beta\}
 \subset\mathcal D_P.
 \label{eq:semiglobal-proxy-compact}
\end{equation}

Define
\begin{equation}
 W_P:=1-c_P+\frac{\|\widetilde{\vct\beta}_\perp\|^2}{2k_I},
 \label{eq:semiglobal-proxy-energy}
\end{equation}
and
\begin{equation}
 V_P:=W_P+\delta_P\vct e_P^\top\widetilde{\vct\beta}_\perp.
 \label{eq:semiglobal-proxy-lyapunov}
\end{equation}
Choose
\begin{equation}
 0<\delta_P<\min\!\left\{
 k_I^{-1/2},\frac{k_P}{k_I+k_P^2/2}\right\},
 \qquad q_P:=\delta_P\sqrt{k_I}<1,
 \label{eq:semiglobal-proxy-delta-condition}
\end{equation}
and define
\begin{align}
 a_P&:=k_P-\delta_Pk_I-\tfrac12\delta_Pk_P^2>0,\\
 \lambda_{0,P}
 &:=\frac{\min\{(1+c_\star)a_P,\delta_Pc_\star k_I\}}
 {1+q_P},
 \qquad \lambda_P:=\tfrac12\lambda_{0,P}.
 \label{eq:semiglobal-proxy-rate}
\end{align}
There are explicit finite gains $L_{\omega,P},L_{b,P}$ on the compact chart;
set
\begin{equation}
 \Upsilon_P:=L_{\omega,P}\bar w_\omega+L_{b,P}\bar w_b.
 \label{eq:semiglobal-proxy-input-gain}
\end{equation}
For the deployed gains, $\delta_P=\SI{5}{s}$ is admissible and gives
$q_P=0.5$ and $a_P=0.025\ \mathrm{s}^{-1}$.

\begin{theorem}[Practical-ISS estimate for the startup proxy]
\label{thm:semiglobal-proxy-explicit}
Let
\begin{align}
 \bar V_{P,0}
 &:=(1+q_P)\left[
 1-\cos\theta_{P,0}^{\max}+\frac{B_{\beta,0}^2}{2k_I}\right],\\
 V_{P,\infty}&:=\left(\frac{\Upsilon_P}{\lambda_{0,P}}\right)^2,\\
 V_{P,\star}&:=(1-q_P)(1-\cos\theta_\star).
 \label{eq:semiglobal-proxy-initial-envelope}
\end{align}
If
\begin{equation}
 \max\{\bar V_{P,0},V_{P,\infty}\}<V_{P,\star},
 \label{eq:semiglobal-proxy-chart-invariance}
\end{equation}
then the trajectory remains in the chart and
\begin{equation}
 \boxed{
 \dot V_P\le-\lambda_PV_P
 +\frac{\Upsilon_P^2}{2\lambda_{0,P}}.}
 \label{eq:semiglobal-proxy-iss-differential}
\end{equation}
Consequently
\begin{equation}
 \boxed{
 V_P(t)\le
 e^{-\lambda_Pt}\bar V_{P,0}
 +(1-e^{-\lambda_Pt})V_{P,\infty}.}
 \label{eq:semiglobal-proxy-iss}
\end{equation}
and
\begin{align}
 \theta_P(t)
 &\le2\sin^{-1}\!\sqrt{\frac{V_P(t)}{2(1-q_P)}},\\
 \|\widetilde{\vct\beta}_\perp(t)\|
 &\le\sqrt{\frac{2k_IV_P(t)}{1-q_P}}.
 \label{eq:semiglobal-proxy-explicit-bounds}
\end{align}
\end{theorem}

\begin{proof}
With zero perturbation,
$\dot W_P=-k_P\|\vct e_P\|^2$.  On $c_P\ge c_\star$,
differentiation of the cross term in Eq.~\eqref{eq:semiglobal-proxy-lyapunov}
and Young inequalities give
\begin{equation}
 \dot V_P
 \le-\lambda_{0,P}V_P+\Upsilon_P\sqrt{V_P}.
\end{equation}
The cross term also gives
$(1-q_P)W_P\le V_P\le(1+q_P)W_P$.
A final Young inequality gives
Eq.~\eqref{eq:semiglobal-proxy-iss-differential}, scalar comparison gives
Eq.~\eqref{eq:semiglobal-proxy-iss}, and the energy identities give the tilt and
bias bounds.  Condition~\eqref{eq:semiglobal-proxy-chart-invariance} keeps the
comparison solution strictly inside the selected chart.
\end{proof}

The almost-global qualification remains topological: a uniform fixed-time bound
cannot extend through initial sets approaching $\mathcal N_P$.  The compact
chart above supplies the quantitative startup family used by the source
certificate.

\subsection{Quality gate and source-shaped handoff}
\label{sec:semiglobal-handoff}

The implemented gravity gate requires
\begin{equation}
 \|\widehat{\vct s}_P\times\widehat{\vct s}_{\rm meas}\|
 \le0.075
 \label{eq:semiglobal-sine-gate}
\end{equation}
and
\begin{equation}
 \boxed{
 \widehat{\vct s}_P^\top\widehat{\vct s}_{\rm meas}>0.}
 \label{eq:semiglobal-aligned-branch}
\end{equation}
If $\eta_g$ bounds the low-pass measured gravity-direction error, every normal
accepted handoff satisfies
\begin{equation}
 \boxed{
 \|\delta\vct\theta_{\perp,H}\|
 \le\bar\theta_{\perp,H}:=\sin^{-1}(0.075)+\eta_g.}
 \label{eq:semiglobal-handoff-tilt}
\end{equation}

Let
\begin{equation}
 \theta_Q:=\sin^{-1}(0.075)-\eta_g>0,
 \qquad
 V_Q:=2(1-q_P)\sin^2(\theta_Q/2).
 \label{eq:semiglobal-quality-target}
\end{equation}
If $V_{P,\infty}<V_Q$, define
\begin{equation}
 \boxed{
 T_Q:=
 \begin{cases}
 0,&\bar V_{P,0}\le V_Q,\\[1ex]
 \displaystyle\frac{1}{\lambda_P}
 \log\!\frac{\bar V_{P,0}-V_{P,\infty}}
 {V_Q-V_{P,\infty}},&\bar V_{P,0}>V_Q.
 \end{cases}}
 \label{eq:semiglobal-quality-entry-time}
\end{equation}
The source additionally requires its \SI{2}{s} hold, gyro-rate veto,
\SI{8}{s} minimum startup, tuner readiness, and a heading gauge when
full-heading handoff is requested.

For a full-heading handoff, let
\begin{equation}
 |\delta\psi_{\rm int,H}|\le\eta_m
 \label{eq:semiglobal-handoff-yaw-internal}
\end{equation}
relative to the adopted horizontal gauge.  The residual true-north offset
$b_{\psi,\mathrm{ref}}$ is excluded from the estimator error metric and enters
true-north reporting only through Eq.~\eqref{eq:iss-true-yaw-error}.  Combine
Eqs.~\eqref{eq:semiglobal-handoff-tilt}--
\eqref{eq:semiglobal-handoff-yaw-internal} with finite physical startup bounds
on $(b_g,v,p,S,a_w,b_a)$ to define the compact source handoff set
\begin{equation}
 \boxed{\mathcal H_{k_H}\subset\mathcal D_{k_H}.}
 \label{eq:semiglobal-capture-entry}
\end{equation}
For diagnostics only,
\begin{equation}
 \vct R_H^{\max}:=\mathcal R_{k_H}(\mathcal H_{k_H}).
 \label{eq:semiglobal-handoff-metric-radius}
\end{equation}
The certificate itself initializes the source-node funnel levels by
Eq.~\eqref{eq:capture-initial-level}; the radius summary is not propagated.

The source enters Live with the linear block enabled and accelerometer-bias
learning held.  The private Mahony integral state is not copied to the MEKF.
The held-bias branch of Theorem~\ref{thm:iss-21-ues} governs the initial
normal-Live mode, and bias release is certified as an exact transition between
the held and active source-node funnels.

\begin{theorem}[Quantified proxy-to-Live regional capture]
\label{thm:semiglobal-proxy-live}
Assume Theorem~\ref{thm:semiglobal-proxy-explicit}, finite completion of the
source hold/rate/tuner/heading gates, the handoff inclusion
Eq.~\eqref{eq:semiglobal-capture-entry}, and the funnel initialization,
source-word, jump, and prefix conditions of
Theorem~\ref{thm:finite-live-capture}.  Then the Mahony contribution to normal
gravity-gate entry is bounded by $T_Q$, every accepted handoff initializes a
proof-safe source-node funnel, and the complete source-realizable Live recursion
enters $\mathcal B$ after the finite count $N_H$ of
Eq.~\eqref{eq:capture-count}.  Thereafter it satisfies
Eq.~\eqref{eq:capture-practical-iss}; Gaussian Live noise is covered only when
the separate drift condition of Theorem~\ref{thm:capture-stochastic-live} is
verified.
\end{theorem}

\begin{proof}
The startup theorem supplies the gravity-direction and observable gyro-bias
envelopes.  The source gates and independent physical startup bounds define
$\mathcal H$.  Equation~\eqref{eq:semiglobal-capture-entry} places that exact
family in the safe Live domain.  Equation~\eqref{eq:capture-initial-level}
embeds each reachable part of $\mathcal H$ directly in its source-node Lyapunov
funnel, and Theorem~\ref{thm:finite-live-capture} propagates only the certified
funnel levels through held mode, bias release, and active mode until inner-funnel
capture.
\end{proof}

\subsection{Timeout handoff}
\label{sec:semiglobal-timeout}

The source timeout is
\begin{equation}
 T_{\rm to}=\max\{T_{\rm proxy},T_{\rm mag-deadline}\}.
 \label{eq:semiglobal-timeout-source-time}
\end{equation}
With the deployed defaults $T_{\rm proxy}=150\,$s and
$T_{\rm mag-deadline}=60\,$s,
\begin{equation}
 \boxed{T_{\rm to}=\SI{150}{s}.}
 \label{eq:semiglobal-timeout-150}
\end{equation}
Evaluate the comparison solution at this time,
\begin{equation}
 \bar V_{P,T}:=
 e^{-\lambda_PT_{\rm to}}\bar V_{P,0}
 +(1-e^{-\lambda_PT_{\rm to}})V_{P,\infty},
 \label{eq:semiglobal-timeout-energy}
\end{equation}
which yields
\begin{equation}
 \boxed{
 \theta_{P,T}\le
 2\sin^{-1}\sqrt{\frac{\bar V_{P,T}}{2(1-q_P)}}.}
 \label{eq:semiglobal-timeout-tilt}
\end{equation}
Together with the physical non-attitude startup bounds, this defines a compact
timeout handoff family $\mathcal H_T$ when a heading gauge is available, or its
yaw-orbit image $\mathcal H_T^\perp$ when it is not.

\begin{theorem}[Gauged and ungauged timeout regional entry]
\label{thm:semiglobal-timeout-live}
Assume the timeout source branch satisfies the aligned-branch test
Eq.~\eqref{eq:semiglobal-aligned-branch} and the physical bounds used above.

If a finite heading gauge is available and
\begin{equation}
 \mathcal H_T\subset\mathcal D,
 \label{eq:semiglobal-timeout-capture-entry}
\end{equation}
then Theorem~\ref{thm:finite-live-capture} applies after computing the timeout
source-node initial levels
$c_{0,i}=\sup_{e\in\mathcal H_T\cap\mathcal D_i}W_i(e)$ and verifying its
word/jump and prefix-safety conditions.

If no heading gauge is available and
\begin{equation}
 \mathcal H_T^\perp\subset\mathcal D^\perp,
 \label{eq:semiglobal-timeout-quotient-entry}
\end{equation}
then Theorem~\ref{thm:hybrid-quotient-capture} gives regional practical
stability modulo yaw.  A later magnetic acquisition transfers the trajectory to
the full-heading chain when its exact jump image satisfies the safe-domain and
recovery condition Eq.~\eqref{eq:hybrid-jump-entry}.
\end{theorem}

The timeout path does not require \texttt{north\_ready}; the two cases preserve
the distinction between an adopted heading gauge and the gravity-only yaw
quotient while using the same source-realizable Live dynamics.

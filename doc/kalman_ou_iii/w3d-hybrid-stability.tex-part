\section{Hybrid Stability Across Live Reconfiguration}
\label{sec:hybrid-live-stability}

Normal Live intervals evolve through the exact map of
Eq.~\eqref{eq:capture-exact-lift}.  Hard attitude/reference events are treated
as explicit jumps
\begin{equation}
 (\vct e^+,\pi^+)=\mathcal R_j(\vct e^-,\pi^-;\mu_j),
 \qquad j\in\{M,T\},
 \label{eq:hybrid-jump-map}
\end{equation}
where $M$ denotes a magnetic-gauge acquisition/refinement and $T$ a tilt
re-lock.  A jump need only remain inside the proof-safe domain and admit a
verified subsequent recovery sequence; it need not land immediately in the
inner regional set.

\subsection{Magnetic-gauge jump}
\label{sec:hybrid-mag-jump}

The source-realizable magnetic family contains the first Live gauge acquisition
when Live began without north, and the one-time refined magnetic reference.  Let
$\rho_M\in\{0,1\}$ identify the two members.  When a finite acquired yaw
$\psi_M$ is available, the nominal attitude operation is
\begin{equation}
 q^+_{bw}=R_z(\psi_M)\,\mathcal Q_{\rm tilt}(q^-_{bw}),
 \label{eq:hybrid-mag-attitude-map}
\end{equation}
while $(b_g,v,p,S,a_w,b_a)$ are numerically unchanged.  The associated source
flags, magnetic reference, hard-iron state, and possible bias-enable covariance
floor are included in the bounded mode map $\pi^+=\mathcal P_M(\pi^-,\rho_M)$.

Let the adopted horizontal gauge change by
\begin{equation}
 \Delta\psi_M=b_{\psi,\mathrm{ref}}^+-b_{\psi,\mathrm{ref}}^-,
 \qquad \mat Q_M=R_z(\Delta\psi_M).
 \label{eq:hybrid-mag-gauge-change}
\end{equation}
The gauge-referenced physical vectors satisfy $x_g^+=\mat Q_Mx_g^-$ for
$x\in\{v,p,S,a_w\}$.  Since the stored additive nominal states are not rotated,
\begin{equation}
 \boxed{
 \vct e_x^+=\vct e_x^-+(\mat I-\mat Q_M)\vct x_g^- .}
 \label{eq:hybrid-mag-world-error-jump}
\end{equation}
Assume
\begin{equation}
 |\Delta\psi_M|\le\bar\Delta_M<\pi,
 \qquad
 |\delta\psi_{\rm int}^+|\le\bar\epsilon_M,
 \label{eq:hybrid-mag-heading-residual}
\end{equation}
and bounded physical world-vector magnitudes
$\|x_g^-\|\le\bar X_M$.  Then
\begin{equation}
 \boxed{
 \|\vct e_x^+\|
 \le\|\vct e_x^-\|
 +2\sin(\bar\Delta_M/2)\bar X_M.}
 \label{eq:hybrid-mag-world-error-bound}
\end{equation}

For any compact pre-jump set $X\subset\mathcal D$, define the exact magnetic
jump image
\begin{equation}
 \boxed{
 \mathfrak J_M(X):=
 \{\mathcal R_M(\vct e,\pi;\mu_M,\rho_M):
 \vct e\in X,\ \pi\in\Pi_M,\ \mu_M\in\mathcal M_M,
 \ \rho_M\in\{0,1\}\}.}
 \label{eq:hybrid-mag-envelope}
\end{equation}
The family is compact under the declared heading and physical-state bounds.
Each of the two magnetic source events occurs at most once.
Continuous hard-iron correction after refinement is a bounded normal-Live
measurement/model change and is therefore contained in
$\Pi^{\rm src}$ rather than in $\mathcal R_M$.

\subsection{Tilt re-lock jump}
\label{sec:hybrid-tilt-jump}

The Live tilt re-lock uses the source map
\begin{equation}
 q^+_{bw}=R_z(\psi^-_{E})Q_y(\vartheta_a)Q_x(\varphi_a),
 \label{eq:hybrid-tilt-attitude-map}
\end{equation}
where $\psi^-_E$ is the pre-reset ZYX Euler yaw and
$(\varphi_a,\vartheta_a)$ are reconstructed from the current accelerometer.
All additive nominal states are unchanged.  The attitude covariance is reseeded
and its cross-covariances are cleared by the implemented reset map.

A deterministic tilt bound requires the reset sample to satisfy
\begin{equation}
 \vct f_b=-g\vct u_d+\vct\epsilon_f,
 \qquad \|\vct\epsilon_f\|\le\bar f_T<g.
 \label{eq:hybrid-tilt-force-bound}
\end{equation}
Then elementary tangent geometry gives
\begin{equation}
 \boxed{
 \|\delta\vct\theta_\perp^+\|
 \le\bar\theta_T:=\sin^{-1}(\bar f_T/g)<\frac{\pi}{2}.}
 \label{eq:hybrid-tilt-reset-bound}
\end{equation}
The reset trigger by itself is not a substitute for
Eq.~\eqref{eq:hybrid-tilt-force-bound}.

Because the source preserves ZYX Euler yaw, admit the compact chart
\begin{equation}
 |\cos\vartheta^-|\ge c_\psi>0,
 \qquad |\cos\vartheta_g|\ge c_\psi>0.
 \label{eq:hybrid-tilt-yaw-chart}
\end{equation}
On this chart
\begin{equation}
 \boxed{
 \epsilon_{\psi,E}^+=\epsilon_{\psi,E}^-,}
 \label{eq:hybrid-tilt-yaw-preserved}
\end{equation}
and smooth coordinate equivalence gives a finite bound on the local yaw
component after reset.  Let $\mathfrak J_T(X)$ denote the exact compact image of
the admissible re-lock guard subset of $X$ under this source map.

The source cooldown supplies the dwell-time bound
\begin{equation}
 T_{\rm cool}=3\ \mathrm{s},
 \qquad
 N_{\rm cool}:=\left\lceil\frac{T_{\rm cool}}{h_+}\right\rceil
 \label{eq:hybrid-tilt-dwell}
\end{equation}
between completed tilt re-locks.

\subsection{Jump-followed-by-flow recovery}

For either jump family, the required certificate is
\begin{equation}
 \boxed{
 \mathfrak J_j(X^-)\subseteq\mathcal D_{k^+},
 \qquad
 \mathfrak T_{k^+,N_j}(\mathfrak J_j(X^-);\bar d)
 \subseteq\mathcal B_{k^++N_j},}
 \label{eq:hybrid-jump-entry}
\end{equation}
with every intermediate prefix contained in $\mathcal D$.  Thus the hard event
may enlarge the error as long as the exact post-jump source dynamics recover
before leaving the safe domain.

For recurrent tilt re-locks, let $V$ be a regional Lyapunov measure on a compact
recovery family containing the admissible guard and jump image.  Suppose the
jump and the shortest source-permitted inter-reset flow satisfy
\begin{align}
 V^+&\le\kappa_TV^-+\delta_T,\\
 V_{k+N_{\rm cool}}&\le
 \lambda_F^{N_{\rm cool}}V_k+\gamma_F,
 \qquad 0<\lambda_F<1.
 \label{eq:hybrid-cycle-bounds}
\end{align}
Define
\begin{equation}
 \boxed{
 \mu_T:=\kappa_T\lambda_F^{N_{\rm cool}}<1.}
 \label{eq:hybrid-cooldown-capture-condition}
\end{equation}

\begin{theorem}[Hybrid Live recovery and recurrent practical stability]
\label{thm:hybrid-live-recovery}
Assume normal-Live intervals satisfy the regional hypotheses of
Theorem~\ref{thm:finite-live-capture}; each magnetic or tilt jump satisfies
Eq.~\eqref{eq:hybrid-jump-entry}; and the tilt reset satisfies
Eqs.~\eqref{eq:hybrid-tilt-force-bound}--
\eqref{eq:hybrid-tilt-yaw-chart}.  Then every finite source-realizable sequence
of hard jumps remains in the certified domain and, after its final jump, enters
$\mathcal B$ in finite time and obeys the regional practical-ISS bound.

If tilt re-locks occur indefinitely and the common recovery-family inequalities
Eq.~\eqref{eq:hybrid-cycle-bounds} hold with
Eq.~\eqref{eq:hybrid-cooldown-capture-condition}, the reset-to-reset sequence is
practically exponentially stable:
\begin{equation}
 \boxed{
 V_n^-
 \le\mu_T^nV_0^-
 +\frac{1-\mu_T^n}{1-\mu_T}
 \left(\lambda_F^{N_{\rm cool}}\delta_T+\gamma_F\right).}
 \label{eq:hybrid-recurrent-bound}
\end{equation}
The source dwell time excludes Zeno behavior.
\end{theorem}

\begin{proof}
For a finite jump sequence, apply Eq.~\eqref{eq:hybrid-jump-entry} after each
hard event and Theorem~\ref{thm:finite-live-capture} on each normal-Live
recovery interval.  For repeated tilt re-locks, substitution of the jump bound
into the shortest admissible flow bound gives
\begin{equation}
 V_{n+1}^-
 \le\mu_TV_n^-+\lambda_F^{N_{\rm cool}}\delta_T+\gamma_F.
\end{equation}
Iteration yields Eq.~\eqref{eq:hybrid-recurrent-bound}.  The fixed positive
cooldown gives a positive lower bound on inter-jump time.
\end{proof}

\subsection{Regional gravity-only capture on the yaw quotient}
\label{sec:hybrid-quotient-capture}

Let $[\vct e]$ denote the orbit of $\vct e$ under the horizontal yaw action
$\mathcal G_\alpha$.  For any full-heading regional metric $V$, define the
gauge-invariant quotient metric
\begin{equation}
 V_k^\perp([\vct e])
 :=\inf_{\alpha\in[-\pi,\pi)}V_k(\mathcal G_\alpha\vct e).
 \label{eq:hybrid-quotient-metric}
\end{equation}
The gravity-only prediction, accelerometer correction, and $S=0$ update are
equivariant, so the exact normal-Live map descends to a well-defined quotient
map $\mathcal F_{k,m}^\perp$.  Let
$\mathcal H_k^\perp$, $\mathcal D_k^\perp$, and
$\mathcal B_k^\perp$ be compact quotient handoff, safe, and inner sets, and
define $\mathfrak T_{k,m}^\perp$ exactly as
Eq.~\eqref{eq:capture-set-envelope} with the quotient map.

\begin{theorem}[Regional gravity-only finite capture modulo yaw]
\label{thm:hybrid-quotient-capture}
If the quotient handoff sequence generated from $\mathcal H^\perp$ has safe
prefixes in $\mathcal D^\perp$, enters $\mathcal B^\perp$ after finitely many
lifts, and the quotient inner set satisfies a contraction inequality of the
form Eq.~\eqref{eq:capture-inner-contraction}, then gravity-only Live operation
is regionally practically ISS modulo yaw.  In particular,
\begin{equation}
 V_{n}^\perp
 \le(\lambda_B^\perp)^nV_0^\perp
 +\frac{1-(\lambda_B^\perp)^n}{1-\lambda_B^\perp}
 \gamma_B^\perp(\bar d).
 \label{eq:hybrid-quotient-practical}
\end{equation}
No absolute-yaw convergence is asserted.
\end{theorem}

\begin{proof}
Equivariance makes the quotient map independent of the chosen orbit
representative.  The set-valued induction and inner-set contraction proof of
Theorem~\ref{thm:finite-live-capture} therefore applies verbatim on the quotient
space.
\end{proof}

If magnetic north is acquired after an ungauged Live handoff, the magnetic jump
selects a horizontal representative and changes the source mode from quotient
to full-heading operation.  The full-heading chain is certified whenever the
resulting jump image lies in $\mathcal D$ and satisfies the direct recovery
condition Eq.~\eqref{eq:hybrid-jump-entry}.

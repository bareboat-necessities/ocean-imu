  \edef\WaveRowWindow{\thisrow{window}}\edef\WaveRowSea{\thisrow{sea}}
  \edef\WaveRowDraw{\thisrow{seed}}\def\WavePlotSea{#1}
  \ifx\WaveRowWindow\WaveWindow\else\def\pgfmathresult{}\fi
  \ifx\WaveRowSea\WavePlotSea\else\def\pgfmathresult{}\fi

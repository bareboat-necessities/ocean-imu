% Publication excerpt of the committed OU--III robustness evidence.
% The OFAT columns are independent of the retired coupled law.  Coupled columns
% are added by tools/ou_publication_sync.py only after the robustness bundle has
% been regenerated by the current SpectralMSE driver.

\begin{table*}[t]
  \centering
  \caption{OU--III one-factor-at-a-time tuning sensitivity at the nominal
  $H_s=1.5$ m sea.  Entries are vertical-displacement RMS error in percent of
  $H_s$ (mean $\pm$ sample standard deviation, $n=\OURobustnessPairs$ paired
  seed triplets).  The other two quantities are held fixed in each column.}
  \label{tab:ou_robustness_sensitivity}
  \footnotesize
  \setlength{\tabcolsep}{9pt}
  \begin{tabular}{@{}rrrr@{}}
    \toprule
    Multiplier & $\tau$ only & $\sigma_{aw}$ only & $r_S$ only \\
    \midrule
    0.5  & 5.19 $\pm$ 0.09 & 4.87 $\pm$ 0.13 & 5.66 $\pm$ 0.10 \\
    0.75 & 4.97 $\pm$ 0.10 & 4.87 $\pm$ 0.12 & 5.08 $\pm$ 0.10 \\
    1.0  & 4.88 $\pm$ 0.11 & 4.88 $\pm$ 0.11 & 4.88 $\pm$ 0.11 \\
    1.25 & 4.84 $\pm$ 0.12 & 4.89 $\pm$ 0.11 & 4.84 $\pm$ 0.13 \\
    1.5  & 4.84 $\pm$ 0.14 & 4.90 $\pm$ 0.10 & 4.88 $\pm$ 0.16 \\
    \bottomrule
  \end{tabular}
\end{table*}


\section{Analytical Foundations for the Source-Reachable Stability Certificate}
\label{sec:stability-widening}

The base Live analysis states source-faithful information and boundedness
conditions for the implemented filter.  This section converts the deployed
marine-motion geometry into explicit sufficient observability and covariance
conditions and shows that the linear homogeneous error remains uniformly
exponentially stable throughout a bounded adaptation envelope.  These results
are analytical foundations for the source-reachable path certificate used below;
they are not a second quantitative basin construction and they do not change the
estimator or its tuning law.

\subsection{Analytical vector observability and adaptation-independent Live UES}
\label{sec:stability-widening-phase-a}

For the deployed marine-motion regime, attitude and gyro-bias information can be
bounded directly from accepted specific-force and magnetic vector packets.  For
a nonzero body vector $\vct u$, let
$\mat J(\vct u):=[\vct u]_\times^\top[\vct u]_\times$.
Suppose an accepted accelerometer--magnetometer packet, after transporting the
two rows to a common packet time with the known nominal attitude transition,
has vectors $\vct f$ and $\vct m$ satisfying
\begin{equation}
 \|\vct f\|\ge f_-,\qquad
 \|\vct m\|\ge m_-,\qquad
 \frac{\|\vct f\times\vct m\|}{\|\vct f\|\,\|\vct m\|}
 \ge s_{fm}>0.
 \label{eq:widen-vector-packet}
\end{equation}
Let the largest accepted three-axis covariance eigenvalues in the packet be
$r_{a,+}$ and $r_{m,+}$, and define
\begin{equation}
 a_f:=\frac{f_-^2}{r_{a,+}},\qquad
 a_m:=\frac{m_-^2}{r_{m,+}},\qquad
 \mu_\theta:=\min\{a_f,a_m\}
 \left(1-\sqrt{1-s_{fm}^2}\right)>0.
 \label{eq:widen-vector-mu}
\end{equation}

\begin{lemma}[Explicit vector-pair attitude coercivity]
\label{lem:widen-vector-coercivity}
Every packet satisfying Eq.~\eqref{eq:widen-vector-packet} contributes attitude
information bounded below by
\begin{equation}
 \mat J(\vct f)/r_{a,+}+\mat J(\vct m)/r_{m,+}
 \succeq \mu_\theta\mat I_3.
 \label{eq:widen-vector-coercivity}
\end{equation}
\end{lemma}

\begin{proof}
Write $\vct u=\vct f/\|\vct f\|$ and
$\vct v=\vct m/\|\vct m\|$.  Since
$[\vct u]_\times^\top[\vct u]_\times=\mat I-\vct u\vct u^\top$, the packet
matrix is bounded below by
\begin{equation}
 \min\{a_f,a_m\}
 \left(2\mat I-\vct u\vct u^\top-\vct v\vct v^\top\right).
\end{equation}
The eigenvalues of the matrix in parentheses are
$2$, $1+|\vct u^\top\vct v|$, and $1-|\vct u^\top\vct v|$.
Equation~\eqref{eq:widen-vector-packet} gives
$|\vct u^\top\vct v|\le\sqrt{1-s_{fm}^2}$, proving the claim.
\end{proof}

To expose gyro bias, consider two accepted packets separated by
$\Delta_g\in[\Delta_{g,-},\Delta_{g,+}]$.  In transported local coordinates the
homogeneous attitude/gyro-bias error has the source-consistent form
\begin{equation}
 \delta\vct\theta_1
 =\mat\Phi_\theta\delta\vct\theta_0
  +\mat\Gamma_g\delta\vct b_g,
 \qquad
 \mat\Gamma_g:=\int_0^{\Delta_g}
 \mat\Phi_\theta(\Delta_g,s)\,ds,
 \label{eq:widen-bg-transition}
\end{equation}
where $\mat\Phi_\theta$ is orthogonal for the skew-symmetric nominal rotation
part.  If the nominal body-rate magnitude is bounded by $\bar\omega$ on the
packet interval, then
\begin{equation}
 \|\mat\Gamma_g-\Delta_g\mat I\|
 \le \frac12\bar\omega\Delta_g^2.
 \label{eq:widen-gamma-perturbation}
\end{equation}
Consequently, when $\bar\omega\Delta_{g,+}<2$,
\begin{equation}
 \sigma_{\min}(\mat\Gamma_g)
 \ge g_-:=\Delta_{g,-}
 \left(1-\frac12\bar\omega\Delta_{g,+}\right)>0.
 \label{eq:widen-gamma-lower}
\end{equation}

Because attitude and gyro-bias errors have different units, introduce a fixed
time scale $T_{bg}>0$ and define
\begin{equation}
 \widetilde{\vct b}_g:=T_{bg}\delta\vct b_g,
 \qquad
 \widetilde\mat\Gamma_g:=\mat\Gamma_g/T_{bg},
 \qquad
 \gamma_-:=g_-/T_{bg}>0.
 \label{eq:widen-bg-scaling}
\end{equation}
This is a fixed norm change and does not alter observability or UES.

\begin{lemma}[Two-packet attitude/gyro-bias observability]
\label{lem:widen-two-packet-bg}
If every proof window contains two accepted packets satisfying
Eqs.~\eqref{eq:widen-vector-packet}--\eqref{eq:widen-bg-scaling}, then the
held-bias attitude/gyro-bias Gramian in the dimensionless coordinate
$(\delta\theta,\widetilde b_g)$ has the explicit lower bound
\begin{equation}
 \boxed{
 \alpha_6^{\rm an}:=
 \frac{\mu_\theta}{1+2/\gamma_-^2}>0.}
 \label{eq:widen-alpha6}
\end{equation}
A finite upper bound $\beta_6^{\rm an}$ follows from the compact vector, rate,
covariance, window, and scaling bounds.
\end{lemma}

\begin{proof}
After whitening each packet by its information square root,
Lemma~\ref{lem:widen-vector-coercivity} bounds the two packet outputs below by
$\sqrt{\mu_\theta}$ times
\begin{equation}
 \widetilde\mat T_g=
 \begin{bmatrix}
  \mat I&0\\
  \mat\Phi_\theta&\widetilde\mat\Gamma_g
 \end{bmatrix}.
\end{equation}
Given outputs $(\vct y_0,\vct y_1)$,
$\delta\vct\theta_0=\vct y_0$ and
$\widetilde\vct b_g=\widetilde\mat\Gamma_g^{-1}
(\vct y_1-\mat\Phi_\theta\vct y_0)$.  Orthogonality of
$\mat\Phi_\theta$, Eq.~\eqref{eq:widen-bg-scaling}, and
$(a+b)^2\le2(a^2+b^2)$ give
$\|\widetilde\mat T_g^{-1}\|^2\le1+2/\gamma_-^2$, which yields
Eq.~\eqref{eq:widen-alpha6}.  Boundedness of the same finite stacked operator
gives the upper Gramian bound.
\end{proof}

The deployed active-bias model has finite residual accelerometer-bias
correlation time.  Therefore exponential contraction of any residual unobserved
accelerometer-bias direction combines with the attitude/gyro-bias information
bound above; no additional deployed nine-state excitation condition is added to
the source certificate.

\subsubsection{Adaptation envelope}

Define the compact adaptation-envelope family $\Pi^{\rm env}$ by
\begin{align}
 0<h_-&\le h_k\le h_+,&
 0<\tau_-&\le\tau_k\le\tau_+<\infty,\\
 0<r_-&\le r_{S,k}\le r_+<\infty,&
 0<\sigma_{aw,-}^{\rm proc}&\le\sigma_{aw,k}^{\rm proc}
 \le\sigma_{aw,+}^{\rm proc}<\infty,
 \label{eq:widen-envelope-bounds}
\end{align}
with accepted measurement covariances in fixed positive compact intervals and
usable $S$ firings satisfying Eq.~\eqref{eq:iss-S-gap-bounds}.  No EMA
recurrence, parameter slew bound, wave-period scaling law, or particular power
law is part of $\Pi^{\rm env}$.

\begin{lemma}[Translational information is uniform on the envelope]
\label{lem:widen-envelope-translation}
Lemma~\ref{lem:iss-axis-uco} and the translational process-excitation argument
remain valid for every sequence in $\Pi^{\rm env}$.
\end{lemma}

\begin{proof}
The determinant proof of Lemma~\ref{lem:iss-axis-uco} uses only bounds on
$\tau(t)$, the proof-window length, and lower/upper gaps between selected $S$
firings.  The one-axis controllability determinant is $-1$ for every finite
$\lambda=1/\tau$.  The exact finite-interval process Gramian is continuous and
positive definite on the compact set
$[h_-,h_+]\times[1/\tau_+,1/\tau_-]$, so its minimum eigenvalue has a positive
uniform lower bound.  The positive process-amplitude floor in
Eq.~\eqref{eq:widen-envelope-bounds} completes the uniform covariance bound.
\end{proof}

\begin{theorem}[Adaptation-independent full-heading Live UES]
\label{thm:widen-envelope-ues}
Assume the compact physical geometry and covariance bounds of
Lemma~\ref{lem:widen-two-packet-bg}, the translational conditions of
Lemma~\ref{lem:widen-envelope-translation}, no hard attitude rewrite inside a
normal-Live interval, and the deployed finite bounded residual-accelerometer-
bias correlation time after bias release.  Then the held 18-state and active
21-state homogeneous error transitions are UES uniformly over the compact
envelope.  In particular, linear Live stability does not depend on the
adaptation-law exponents, EMA horizons, or the rate at which admissible values
of $\tau$, $\sigma_{aw}$, and $R_S$ move inside that envelope.
\end{theorem}

\begin{proof}
Lemma~\ref{lem:widen-two-packet-bg} supplies the attitude/gyro-bias information
bound and Lemma~\ref{lem:widen-envelope-translation} supplies uniform
translational observability and process excitation.  The remaining active
process channels and accepted measurement covariances lie in positive compact
sets.  Standard discrete LTV Kalman/Riccati stability therefore gives uniform
UES in held mode, with held accelerometer bias acting as a bounded input.  After
release, finite $\tau_b$ exponentially contracts any residual unobserved
accelerometer-bias direction and gives uniform detectability for the active
mode.
\end{proof}

\begin{remark}[Role of the envelope theorem]
\label{rem:widen-phase-a-meaning}
The envelope theorem establishes structural stability and boundedness independent
of the particular adaptation law.  Quantitative deployed certification does not
optimize over arbitrary envelope switching; it is performed only on the
source-reachable word graph of Sec.~\ref{sec:stability-widening-source-path}.
Thus the envelope is an analytical hypothesis set, not a parallel basin
certificate.
\end{remark}

\section{Sea-State Adaptation and Integral-State Regularization}
\label{sec:adaptation-motivation}\label{sec:integral-regularization-theory}
\label{sec:adaptation}\label{sec:adapt-impl}\label{app:rs-scaling}
Adaptation uses two physical observables: the elevation zero-crossing period
$\widehat T_z$ and the noise-corrected band-limited acceleration
$\widehat\sigma_{a,B}$. They determine an approximate OU prior and,
independently, the drift--distortion balance of the integral regularizer.
We use $T_{\rm sea}=\widehat T_z/2$ as the scheduler time scale.
\label{eq:adapt-sea-time}

\input{w3d-adaptation-observables.tex-part}

\subsection{Measured acceleration scale and OU prior amplitude}
\label{sec:adaptation-sigma-map}
At fixed normalized spectral shape, acceleration RMS scales linearly with
wave amplitude. The OU prior uses
\begin{equation}
\sigma_{aw,\star}=c_\sigma\widehat\sigma_{a,B,\star},\qquad c_\sigma=0.9.
\label{eq:adapt-sigma-map}
\end{equation}
This prior amplitude is not the physical acceleration statistic entering the
regularizer's distortion cost.

\subsection{Sea time scale and OU correlation time}
\label{sec:adaptation-tau-map}
The time-scale target is
\begin{equation}
\tau_\star=c_\tau T_{\rm sea}=c_\tau\widehat T_z/2,\qquad c_\tau=1.
\label{eq:adapt-tau-map}
\end{equation}
The OU model approximates correlation time; it does not reproduce the full
wave spectrum. Both targets are bounded and smoothed as specified below.

\subsection{Posterior acceleration error and spectral regularization}
\label{sec:adaptation-posterior-error}\label{sec:adaptation-regularizer-transfer}
For a scalar OU acceleration observed with continuous noise density $r_a$,
the low-frequency posterior error intensity is
\begin{equation}
\Lambda=\frac{2\sigma_{aw}^2\tau}{r_a},\qquad
q_{\mathrm{eff}}=2r_a\bigl[1-(1+\Lambda)^{-1/2}\bigr].
\label{eq:adapt-Lambda}
\end{equation}
The implementation uses its strong-observation limit
\begin{equation}
q_{\mathrm{eff}}\simeq2r_a=2R_a h.
\label{eq:adapt-qeff-strong}
\end{equation}
Here $R_a$ is the separately configured scalar noise variance for this reduced
model, not the tuner's variance-floor setting or the vibration-inflated MEKF
covariance. With $\sqrt{R_a}=\SI{0.0148}{m.s^{-2}}$ and $h=\SI{5}{ms}$,
$q_{\rm eff}=2.1904\times10^{-6}$ in acceleration-intensity units.
Tilt leakage and bias coupling are not represented by this scalar limit.

An $S=0$ update of variance $R_S=r_S^2$ every $T_S$ has high-rate
information-equivalent density $r_{S,c}=R_ST_S$.
\label{eq:adapt-continuous-rs-density}
For the reduced state $[S,p,v]^\top$, the continuous Riccati gain and corner are
\begin{equation}
\vct K_d=[2\omega_R,\;2\omega_R^2,\;\omega_R^3]^\top,\qquad
\omega_R=\left(\frac{q_{\mathrm{eff}}}{R_ST_S}\right)^{1/6}.
\label{eq:adapt-omegaR}
\end{equation}
The corrected chain $\dot S=p-2\omega_RS$,
$\dot p=v-2\omega_R^2S$, $\dot v=a-\omega_R^3S$ gives
\begin{equation}
H_{pa}(s)=\frac{s+2\omega_R}{s^3+2\omega_Rs^2+2\omega_R^2s+\omega_R^3},
\qquad G(s)=s^2H_{pa}(s).
\label{eq:adapt-Hpa}
\end{equation}
Relative to ideal double integration, with $x=\omega/\omega_R$,
\begin{align}
|G(j\omega)|^2&=\frac{x^4(x^2+4)}{1+x^6},
\label{eq:adapt-G-mag}\\
|G(j\omega)-1|^2&=\frac{1+4x^2}{1+x^6}.
\label{eq:adapt-G-error}
\end{align}
Thus $S_{\hat p}^{(2)}=|G|^2S_\eta^{(2)}$: low-frequency drift is suppressed,
but real displacement near the regularization corner is also distorted.
\label{eq:adapt-output-spectrum}

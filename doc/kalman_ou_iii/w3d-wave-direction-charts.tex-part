% =======================================================
% Publication figures for kalman-wave-dir.tex.
% The PGF files are generated by plots/kalman_ou_iii/kalman_ou_iii-plots.py
% during the existing kalman_ou_iii build job and moved into this directory
% before LaTeX compilation.  Keep these as single-column IEEE figures.

\begin{figure}[!t]
  \centering
  \resizebox{\columnwidth}{!}{%
    \input{w3d_ou3_jonswap_medium_dir.pgf}%
  }
  \caption{Representative wave-direction telemetry for the medium JONSWAP
  sea.  From top to bottom the generated diagnostic shows the axial direction
  estimate, its approximate 95\% angular uncertainty, the direction-confidence
  statistic, and the resolved apparent travel-sense state
  ($-1/0/+1$ = negative-axis/unresolved/positive-axis).  The last state is
  defined relative to the estimator's current axial representative; the final
  directed propagation vector is invariant to a $180^\circ$ representative
  flip.}
  \label{fig:wave-dir-jonswap-medium}
\end{figure}

\begin{figure}[!t]
  \centering
  \resizebox{\columnwidth}{!}{%
    \input{w3d_ou3_jonswap_low_dir.pgf}%
  }
  \caption{Low-energy JONSWAP direction telemetry.  This case exposes the
  confidence and uncertainty behavior most clearly: the estimator is permitted
  to report an unresolved travel sense rather than forcing a directed answer
  when the directional excitation or confidence gates are not satisfied.}
  \label{fig:wave-dir-jonswap-low}
\end{figure}

\begin{figure}[!t]
  \centering
  \resizebox{\columnwidth}{!}{%
    \input{w3d_ou3_pmstokes_medium_dir.pgf}%
  }
  \caption{Representative wave-direction telemetry for the medium PM--Stokes
  sea.  The same axial-direction, uncertainty, confidence, and apparent
  travel-sense diagnostics are shown for the secondary spectral family with
  nonlinear Stokes harmonics.}
  \label{fig:wave-dir-pmstokes-medium}
\end{figure}

\section{Measurement Update and MEKF Reset}
\label{sec:meas-update-structure}

At each IMU step, the gyroscope propagates the nominal quaternion and process
covariance; accelerometer, magnetometer, and integral-drift channels provide
rank--3 corrections.  For
\[
\vct{z}=h(\vct{x})+\vct{\nu},
\qquad
\vct{\nu}\sim\mathcal{N}(0,\mat{R}),
\qquad
\mat{C}=\left.\frac{\partial h}{\partial\delta\vct{x}}\right|_{\hat{\vct{x}}^-},
\]
define
\begin{align}
\vct{r}&=\vct{z}-h(\hat{\vct{x}}^-),\\
\matg{\Lambda}&=\mat{C}\mat{P}^-\mat{C}^{\top}+\mat{R},\\
\mat{K}&=\mat{P}^-\mat{C}^{\top}\matg{\Lambda}^{-1}.
\label{eq:kalman-gain}
\end{align}
The error-state and Joseph covariance updates are
\begin{equation}
\delta\hat{\vct{x}}^+=\delta\hat{\vct{x}}^-+\mat{K}\vct{r},
\end{equation}
\begin{equation}
\mat{P}^+=(\Id-\mat{K}\mat{C})\mat{P}^-(\Id-\mat{K}\mat{C})^{\top}
+\mat{K}\mat{R}\mat{K}^{\top}.
\label{eq:joseph-update}
\end{equation}

\subsection{Rank--3 block structure}
Partition
\[
\delta\vct{x}=[\vct{A}^{\top},\vct{L}^{\top},\vct{B}^{\top}]^{\top},
\]
where $\vct{A}\in\mathbb{R}^6$,
$\vct{L}=[\delta\vct{v},\delta\vct{p},\delta\vct{S},
\delta\vct{a}_w]\in\mathbb{R}^{12}$, and
$\vct{B}=\delta\vct{b}_a\in\mathbb{R}^3$.  Each correction therefore requires
the $3\times3$ innovation solve of Eq.~\eqref{eq:kalman-gain}, while
cross-covariances can update state groups not directly selected by $\mat C$.
The accelerometer, magnetometer, and integral-channel Jacobians are given by
Eqs.~\eqref{eq:acc-meas-jacobians}, \eqref{eq:mag-meas-jacobian}, and
\eqref{eq:HS-selector}, respectively, with columns ordered as in
\eqref{eq:state-vector}.

\subsection{Nominal-state injection and quaternion reset}
After an accepted correction, additive states are injected as
\begin{align}
\hat{\vct{b}}_g &\leftarrow \hat{\vct{b}}_g+\delta\hat{\vct{b}}_g,&
\hat{\vct{v}} &\leftarrow \hat{\vct{v}}+\delta\hat{\vct{v}},\\
\hat{\vct{p}} &\leftarrow \hat{\vct{p}}+\delta\hat{\vct{p}},&
\hat{\vct{S}} &\leftarrow \hat{\vct{S}}+\delta\hat{\vct{S}},\\
\hat{\vct{a}}_w &\leftarrow \hat{\vct{a}}_w+\delta\hat{\vct{a}}_w,&
\hat{\vct{b}}_a &\leftarrow \hat{\vct{b}}_a+\delta\hat{\vct{b}}_a.
\label{eq:additive-state-injection}
\end{align}
Disabled bias terms are omitted.  The left-multiplicative quaternion injection
then uses
\begin{equation}
q\leftarrow\exp_q\!\left(\tfrac12\delta\hat{\vct{\theta}}\right)\otimes q.
\label{eq:quat-error-injection}
\end{equation}
Because this changes local attitude coordinates, simply setting
$\delta\hat{\vct\theta}=0$ is not covariance consistent.  To first order,
\begin{equation}
\mat{G}_{\theta}
=\Id+\tfrac12\Skew{\delta\hat{\vct{\theta}}},
\qquad
\mat{G}_{\mathrm{reset}}
=\blkdiag(\mat{G}_{\theta},\Id_{N_X-3}),
\label{eq:left-reset-jacobian}
\end{equation}
followed by
\begin{equation}
\mat{P}^+
\leftarrow
\mat{G}_{\mathrm{reset}}\mat{P}^+
\mat{G}_{\mathrm{reset}}^{\top},
\qquad
\delta\hat{\vct{\theta}}\leftarrow0.
\label{eq:mekf-reset-covariance}
\end{equation}
This transformation applies to the attitude marginal and all attitude
cross-covariances whenever a correction induces nonzero attitude error.

\subsection{Numerical invariants}
The innovation matrix uses an LDL$^{\top}$ solve with a scale-dependent diagonal
safeguard only when needed.  The Joseph update, covariance symmetrization, and
MEKF reset preserve $\mat P=\mat P^\top$, $\mat P\succeq0$, unit quaternion
norm, and zero local attitude-error mean to numerical precision.

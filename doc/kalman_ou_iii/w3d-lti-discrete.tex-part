\subsection{Discretization of a generic LTI SDE over step \texorpdfstring{$h$}{h}}
\label{sec:lti-disc}

Consider the LTI SDE
\begin{equation}
\fitcol{
\dot{\delta\vct{x}}(t)
  = \mat{F}\,\delta\vct{x}(t) + \mat{L}\,\vct{w}_c(t),
\quad
\mathbb{E}\bigl[\vct{w}_c(t)\vct{w}_c^\top(s)\bigr]
  = \matg{Q}_c\,\delta(t{-}s),
}
\end{equation}
with dynamics matrix $\mat F$, noise-input matrix $\mat L$, and continuous
spectral density $\matg Q_c$.

\paragraph{State transition via the matrix exponential}
For $h>0$,
\begin{equation}
\delta\vct{x}(t{+}h)
  \;=\;
  \underbrace{e^{\mat{F} h}}_{\displaystyle \matg{\Phi}(h)}\,\delta\vct{x}(t)
  \;+\;
  \int_{0}^{h} e^{\mat{F} (h-s)}\,\mat{L}\,\vct{w}_c(t{+}s)\,ds,
\end{equation}
where $\matg\Phi(h)=e^{\mat Fh}$ is the exact discrete state transition.

\paragraph{Discrete process covariance}
The process noise accrued over $[t,t+h]$ is
\begin{equation}
\matg{Q}_d(h)
\;=\;
\int_{0}^{h}
  e^{\mat{F} s}\,\mat{L}\,\matg{Q}_c\,\mat{L}^\top\,
  e^{\mat{F}^\top s}\,ds.
\label{eq:Qd-integral}
\end{equation}
For the temperature-centered residual accelerometer-bias OU state,
\begin{align}
\mat\Phi_b(h)
&=e^{-h/\tau_b}\mat I_3,\label{eq:ba-ou-phi}\\
\matg Q_{d,b}(h)
&=\frac{\tau_b}{2}\left(1-e^{-2h/\tau_b}\right)\matg Q_{ba}.
\label{eq:ba-ou-Qd}
\end{align}
The scalar covariance factor is evaluated as
$-\frac{\tau_b}{2}\operatorname{expm1}(-2h/\tau_b)$ for numerical accuracy
when $h/\tau_b\ll1$.  Hence
$\matg Q_{d,b}=h\matg Q_{ba}+O(h^2/\tau_b)$, preserving the former random-walk
process covariance to first order on short IMU steps.

\paragraph{Discrete Kalman prediction (time update)}
Given $(\hat{\vct{x}}_k,\mat{P}_k)$ at $t_k$,
\begin{align}
\hat{\vct{x}}_{k+1|k} &= \matg{\Phi}(h)\,\hat{\vct{x}}_k,\\
\mat{P}_{k+1|k} &= \matg{\Phi}(h)\,\mat{P}_k\,\matg{\Phi}(h)^\top \;+\; \matg{Q}_d(h).
\end{align}
The OU-driven kinematic transition and covariance are analytic, including the
small-step branch; Eqs.~\eqref{eq:ba-ou-phi}--\eqref{eq:ba-ou-Qd} handle the
residual bias.  The attitude/gyro-bias transition is exact for constant angular
rate, with Simpson quadrature used only for anisotropic attitude-noise and
bias-driven covariance integrals as described next.

\subsection{Discretization of a generic LTI SDE over step \texorpdfstring{$h$}{h}}
\label{sec:lti-disc}

Consider a linear time--invariant SDE
\begin{equation}
\fitcol{
\dot{\delta\vct{x}}(t)
  = \mat{F}\,\delta\vct{x}(t) + \mat{L}\,\vct{w}_c(t),
\quad
\mathbb{E}\bigl[\vct{w}_c(t)\vct{w}_c^\top(s)\bigr]
  = \matg{Q}_c\,\delta(t{-}s),
}
\end{equation}
with Jacobian (linearized) dynamics matrix $\mat{F}$, noise--input matrix $\mat{L}$,
and continuous spectral density $\matg{Q}_c$.

\paragraph{State transition via the matrix exponential}
Over a small step $h>0$, the exact discrete transition of the mean is
\begin{equation}
\delta\vct{x}(t{+}h)
  \;=\;
  \underbrace{e^{\mat{F} h}}_{\displaystyle \matg{\Phi}(h)}\,\delta\vct{x}(t)
  \;+\;
  \int_{0}^{h} e^{\mat{F} (h-s)}\,\mat{L}\,\vct{w}_c(t{+}s)\,ds.
\end{equation}
The matrix exponential is defined by the absolutely convergent series
$e^{\mat{F} h}=\sum_{k=0}^{\infty}\frac{(\mat{F} h)^k}{k!}$.
In this setting $\matg{\Phi}(h)=e^{\mat{F} h}$ is the
\emph{discrete state transition}.

\paragraph{Discrete process covariance}
Let $\matg{Q}_d(h)$ denote the process noise accrued over $[t,t{+}h]$.
From the stochastic variation-of-constants formula,
\begin{equation}
\matg{Q}_d(h)
\;=\;
\int_{0}^{h}
  e^{\mat{F} s}\,\mat{L}\,\matg{Q}_c\,\mat{L}^\top\,
  e^{\mat{F}^\top s}\,ds.
\label{eq:Qd-integral}
\end{equation}

For the temperature-centered residual accelerometer-bias OU state, the scalar
block is particularly simple. With continuous driving spectral density
$\matg Q_{ba}$ and correlation time $\tau_b$,
\begin{align}
\mat\Phi_b(h)
&=e^{-h/\tau_b}\mat I_3,\label{eq:ba-ou-phi}\\
\matg Q_{d,b}(h)
&=\frac{\tau_b}{2}\left(1-e^{-2h/\tau_b}\right)\matg Q_{ba}.
\label{eq:ba-ou-Qd}
\end{align}
The implementation evaluates the scalar covariance factor as
$-\frac{\tau_b}{2}\operatorname{expm1}(-2h/\tau_b)$ to avoid cancellation for
$h/\tau_b\ll1$. Consequently
$\matg Q_{d,b}=h\matg Q_{ba}+O(h^2/\tau_b)$, so retaining the historical
continuous driving density preserves the former random-walk process covariance
to first order on short IMU steps.

\paragraph{Discrete Kalman prediction (time update)}
Given $(\hat{\vct{x}}_k,\mat{P}_k)$ at $t_k$, the prediction to $t_{k+1}=t_k{+}h$ is
\begin{align}
\hat{\vct{x}}_{k+1|k} &= \matg{\Phi}(h)\,\hat{\vct{x}}_k,\\
\mat{P}_{k+1|k} &= \matg{\Phi}(h)\,\mat{P}_k\,\matg{\Phi}(h)^\top \;+\; \matg{Q}_d(h).
\end{align}
These equations are the discrete counterparts of the continuous covariance
flow for the local-error SDE defined in Sec.~\ref{sec:proc}.  The OU-driven
kinematic transition and process covariance are evaluated analytically,
including the small-step series branch. The residual accelerometer-bias block
uses Eqs.~\eqref{eq:ba-ou-phi}--\eqref{eq:ba-ou-Qd}. The attitude/gyro-bias
transition is structured and exact for constant angular rate, while anisotropic
attitude-noise and bias-driven covariance integrals use Simpson quadrature, as
stated in the following attitude-block derivation.

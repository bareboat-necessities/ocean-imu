  "local_orchestration": "import concurrent.futures, hashlib, importlib.util, json, os, re, subprocess, sys, tempfile\nfrom pathlib import Path\nimport pandas as pd\nROOT=Path('/workspace/scratch/0f70d6e02277/ocean-imu-moving')\nsys.path.insert(0,str(ROOT/'tools'))\nimport sim_dataset\nspec=importlib.util.spec_from_file_location('baseline',ROOT/'plots/kalman_ou_iii/baseline-comparison.py')\nb=importlib.util.module_from_spec(spec);spec.loader.exec_module(b)\nBIN={\n'ou3':ROOT/'tests/kalman_ou_iii/kalman_ou_iii-sim',\n'ou2':ROOT/'tests/kalman_ou_ii/kalman_ou_ii-sim',\n 'tfg':ROOT/'tests/kalman_tfg/kalman_tfg-sim',\n 'pii':ROOT/'tests/pii_observer/pii_observer-adaptive',\n 'nlo':ROOT/'tests/nlo/nlo-sim'}\nOUT=ROOT/'reports/results/baseline_comparison'\nOUT.mkdir(parents=True,exist_ok=True)\ncols=['time','disp_est_z','disp_ref_z','roll_est','roll_ref','pitch_est','pitch_ref']\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\ninitial={m:sha(p) for m,p in BIN.items()}\ndef run(job):\n method,name=job\n with tempfile.TemporaryDirectory(prefix='moving-baseline-') as td:\n  temp=Path(td);src=ROOT/'.sim-data'/sim_dataset.SHA256/name;(temp/name).symlink_to(src)\n  env={k:v for k,v in os.environ.items() if not k.startswith(('W3D_','OU_','SF_','TFG_','PII_','NLO_'))}\n  env.update(W3D_WRITE_TIMESERIES='1',W3D_VALIDATION_WINDOW_SEC='900',W3D_COLLECT_ALL_GATES='1')\n  cmd=[str(BIN[method])]\n  if method in ('ou2','ou3','tfg'):cmd+=['--input',str(temp/name)]\n  r=subprocess.run(cmd,cwd=temp,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=600)\n  if r.returncode!=0:raise RuntimeError(method+name+r.stdout[-3000:])\n  outputs=list(temp.glob('w3d_*.csv'))\n  if len(outputs)!=1:raise RuntimeError(str(outputs))\n  raw=outputs[0];rawhash=sha(raw);frame=pd.read_csv(raw,usecols=cols)\n  if len(frame)!=240000:raise ValueError('incomplete trace')\n  scored=b.tail(frame);err=b.rms(scored.disp_est_z-scored.disp_ref_z)\n  hs=float(re.search(r'_H([\\d.